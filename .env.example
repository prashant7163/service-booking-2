# Supply these variables in the shell or an untracked .env file.
# DB_URL: PostgreSQL JDBC URL; Compose supplies its internal synthetic database URL.
DB_URL=
# DB_PORT: optional local published database port; defaults to 5432; 0 selects a free port.
DB_PORT=
# WEB_PORT: optional local web port; defaults to 3000.
WEB_PORT=
# SIMULATED_VERIFICATION_ENABLED: set true only while a local receiver is already listening.
SIMULATED_VERIFICATION_ENABLED=false
# DB_USER: local synthetic PostgreSQL account name.
DB_USER=
# DB_PASSWORD: choose a local password; never commit it.
DB_PASSWORD=
# REDEMPTION_HMAC_SECRET: generate a random secret outside version control.
REDEMPTION_HMAC_SECRET=
